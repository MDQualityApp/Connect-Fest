		{
			"name": "2. Razorpay Payments",
			"description": "Payment workflow: Create Order for a stall, and Verify Razorpay Payment Signature.",
			"item": [
				{
					"name": "2.1 Create Razorpay Order",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.message && jsonData.message.order && jsonData.message.order.id) {",
									"    pm.collectionVariables.set('orderId', jsonData.message.order.id);",
									"    console.log('Saved orderId: ' + jsonData.message.order.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"registration_id\": \"{{registrationId}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/method/connectfest.api.create_razorpay_order",

		{
			"name": "4. Lookups & Monitoring",
			"description": "Lookup registration records by ID, check ingestion queue status, and trigger bulk worker flush.",
			"item": [
				{
					"name": "4.1 Get Stall Registration Details (Universal)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/method/connectfest.api.get_registration?registration_id={{registrationId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"method",
								"connectfest.api.get_registration"
							],
							"query": [
								{
									"key": "registration_id",
									"value": "{{registrationId}}",
									"description": "Supports both Stall ID (CF-...) and Visitor ID (VIS-...)"
								}
							]
						},
						"description": "Fetches registration details. First checks Redis memory cache (<1ms), then falls back to MariaDB."
					},
					"response": []
				},
